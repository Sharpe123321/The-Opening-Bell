{
  "rewrites": [
    {
      "source": "/l/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/season",
      "destination": "/index.html"
    },
    {
      "source": "/parent",
      "destination": "/index.html"
    },
    {
      "source": "/trail",
      "destination": "/index.html"
    },
    {
      "source": "/calendar",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "afterbell-ca.vercel.app"
        }
      ],
      "destination": "https://cluedrop.vercel.app/:path",
      "permanent": false
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "opening-bell-two.vercel.app"
        }
      ],
      "destination": "https://cluedrop.vercel.app/:path",
      "permanent": false
    }
  ]
}
